---
import { getCollection } from 'astro:content';
import { t, type Locale } from '../i18n/translations';

const locale = (Astro.currentLocale || 'zh-CN') as Locale;
const activity = (await getCollection('activity')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<section class="card">
  <h3 class="card-title">{t('home.activity', locale)}</h3>
  <ul class="timeline">
    {activity.map(a => (
      <li class="tl-item">
        <span class="tl-dot"></span>
        <div class="tl-body">
          <time>{a.data.date}</time>
          <p>{a.data.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .card {
    border-radius: 12px;
    background: rgba(255,255,255,.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card-title {
    margin: 0;
    font-family: 'LXGW WenKai', sans-serif;
    font-size: 17px;
    font-weight: 500;
    color: #4a3728;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tl-item { display: flex; gap: 12px; }
  .tl-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #8b5e3c;
    margin-top: 6px;
    flex-shrink: 0;
  }
  .tl-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .tl-body time {
    font-family: 'LXGW WenKai Mono', monospace;
    font-size: 12px;
    color: #b8a088;
  }
  .tl-body p {
    margin: 0;
    font-size: 14px;
    color: #8b7355;
    line-height: 1.6;
  }

  body.dark .card { background: rgba(80,60,48,.6); }
  body.dark .card-title { color: #f0e0d0; }
  body.dark .tl-dot { background: #d4bfa8; }
  body.dark .tl-body time { color: #8b6f5a; }
  body.dark .tl-body p { color: #d4bfa8; }

  @media (max-width: 600px) {
    .card { padding: 16px; }
  }
</style>
