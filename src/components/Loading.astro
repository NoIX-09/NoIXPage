---
import { Image } from 'astro:assets';
import loadingImg from '../assets/noix-loading.png';
---

<div class="loading-overlay" id="noix-loading" role="status" aria-label="Loading" data-mascot>
  <Image class="loading-img" src={loadingImg} alt="" width={480} height={270} />
</div>

<script>
  (function () {
    const overlay = document.getElementById('noix-loading');
    if (!overlay) return;

    // bfcache 后退/前进恢复时不会触发 load，这里强制隐藏残留的 loading，避免卡在加载画面
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) overlay.classList.remove('show');
    });

    // 路由 loading：点击站内链接跳转时显示，跳转后由新页接管
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const el = e.target;
      const a = el && el.closest ? el.closest('a') : null;
      if (!a) return;
      if (a.target && a.target !== '_self') return;
      const href = a.getAttribute('href');
      if (!href) return;
      let url;
      try { url = new URL(href, location.href); } catch { return; }
      if (url.origin !== location.origin) return;                       // 外链不处理
      if (url.pathname === location.pathname && url.search === location.search) return; // 纯锚点/同页
      overlay.classList.add('show');
      // 兜底：若跳转被取消/失败（页面未卸载），几秒后强制隐藏，避免卡住
      window.setTimeout(() => overlay.classList.remove('show'), 10000);
    });

    const KEY = 'noix-loading-shown';
    const DURATION = 1500; // 首次进入固定放映时长（ms）

    // 首次进入：固定放映 1.5s 后淡出
    if (!sessionStorage.getItem(KEY)) {
      sessionStorage.setItem(KEY, '1');
      overlay.classList.add('show');
      window.setTimeout(() => overlay.classList.remove('show'), DURATION);
      return;
    }

    // 非首次进入：保留原「加载慢才显示」逻辑，避免快速加载时闪烁
    const threshold = 100;   // ms 后仍未加载完成才显示（网络差时更快触发）
    const minVisible = 350;  // 显示后至少保持的时长，避免一闪而过
    let loaded = false;
    let shownAt = 0;
    let timer = 0;

    const hide = () => {
      if (loaded) return;
      loaded = true;
      window.clearTimeout(timer);
      const remaining = shownAt ? Math.max(0, minVisible - (Date.now() - shownAt)) : 0;
      window.setTimeout(() => overlay.classList.remove('show'), remaining);
    };

    timer = window.setTimeout(() => {
      if (loaded) return;
      shownAt = Date.now();
      overlay.classList.add('show');
    }, threshold);

    if (document.readyState === 'complete') {
      hide();
    } else {
      window.addEventListener('load', hide, { once: true });
    }
  })();
</script>

<style>
  .loading-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(250, 243, 230, 0.75);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }
  .loading-overlay.show {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .loading-img {
    width: 240px;
    height: auto;
    animation: loading-float 2.4s ease-in-out infinite;
  }
  @keyframes loading-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  body.dark .loading-overlay { background: rgba(42, 31, 26, 0.8); }

  @media (max-width: 600px) {
    .loading-img { width: 200px; }
  }
</style>
