---
import { Image } from 'astro:assets';
import loadingImg from '../assets/noix-loading.png';
---

<div class="loading-overlay" id="noix-loading" role="status" aria-label="Loading" data-mascot>
  <Image class="loading-img" src={loadingImg} alt="" width={480} height={270} />
</div>

<script>
  (function () {
    const overlay = document.getElementById('noix-loading');
    if (!overlay) return;

    const MIN = 1000; // 最短放映时长（ms）：不固定，至少 1s，加载完成后自行退出
    const shownAt = Date.now();
    let hidden = false;

    const hide = () => {
      if (hidden) return;
      hidden = true;
      const remaining = Math.max(0, MIN - (Date.now() - shownAt));
      window.setTimeout(() => overlay.classList.add('hidden'), remaining);
    };

    // 页面加载完成即隐藏（至少放映 MIN 时长；慢网时一直覆盖到加载完）
    if (document.readyState === 'complete') {
      hide();
    } else {
      window.addEventListener('load', hide, { once: true });
    }

    // bfcache 后退/前进恢复时不会触发 load，强制隐藏残留的 loading
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) overlay.classList.add('hidden');
    });

    // 路由 loading：点击站内链接跳转时重新显示，覆盖浏览器本身的加载过程
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const el = e.target;
      const a = el && el.closest ? el.closest('a') : null;
      if (!a) return;
      if (a.target && a.target !== '_self') return;
      const href = a.getAttribute('href');
      if (!href) return;
      let url;
      try { url = new URL(href, location.href); } catch { return; }
      if (url.origin !== location.origin) return;                       // 外链不处理
      if (url.pathname === location.pathname && url.search === location.search) return; // 纯锚点/同页
      overlay.classList.remove('hidden');
      // 兜底：跳转被取消/失败（页面未卸载）时，几秒后强制隐藏，避免卡住
      window.setTimeout(() => overlay.classList.add('hidden'), 10000);
    });
  })();
</script>

<style>
  .loading-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(250, 243, 230, 0.75);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }
  .loading-overlay.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .loading-img {
    width: 240px;
    height: auto;
    animation: loading-float 2.4s ease-in-out infinite;
  }
  @keyframes loading-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  body.dark .loading-overlay { background: rgba(42, 31, 26, 0.8); }

  @media (max-width: 600px) {
    .loading-img { width: 200px; }
  }
</style>
