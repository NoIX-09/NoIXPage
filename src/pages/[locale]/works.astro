---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../../site.config';
import { getCollection } from 'astro:content';
import { t, LOCALES, type Locale } from '../../i18n/translations';

export function getStaticPaths() {
  return LOCALES.map(l => ({ params: { locale: l } }));
}

const locale = (Astro.currentLocale || 'zh-CN') as Locale;
const works = await getCollection('works');
---

<Layout title="Works · NoIX Page" siteName={site.name}>
  <div class="page">
    <h1 class="page-title">{t('works.title', locale)}</h1>
    <hr class="pencil-line wide" />
    <div class="works-grid">
      {works.length > 0 ? (
        works.map((w) => (
          <a class="work-card" href={w.data.url} target="_blank" rel="noopener">
            <div class="work-icon">
              <Icon name="ph:palette-duotone" size="24" />
            </div>
            <div class="work-info">
              <h3>{w.data.name}</h3>
              <p>{w.data.desc}</p>
            </div>
          </a>
        ))
      ) : (
        <div class="empty-hint">
          <Icon name="ph:palette-duotone" size="40" />
          <p>{t('works.emptyHint', locale)}</p>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .page {
    flex: 1;
    width: 100%;
    max-width: 880px;
    padding: 40px 24px 0;
    box-sizing: border-box;
  }
  .page-title {
    font-family: 'LXGW WenKai', sans-serif;
    font-size: 28px;
    font-weight: 500;
    color: #4a3728;
    margin: 0 0 28px;
  }
  .works-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .work-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    border-radius: 12px;
    background: rgba(255,255,255,.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    text-decoration: none;
    transition: transform .2s, background .2s;
  }
  .work-card:hover { transform: translateY(-2px); background: rgba(255,255,255,.7); }
  .work-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: rgba(139,94,60,.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .work-icon :global(svg) { color: #8b5e3c; }
  .work-info { min-width: 0; }
  .work-info h3 { margin: 0; font-family: 'LXGW WenKai', sans-serif; font-size: 16px; font-weight: 500; color: #4a3728; }
  .work-info p { margin: 6px 0 0; font-size: 13px; color: #8b7355; line-height: 1.6; }
  .empty-hint {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 60px 0;
    color: #b8a088;
  }
  .empty-hint p { margin: 0; font-family: 'LXGW WenKai', sans-serif; font-size: 15px; }

  body.dark .page-title { color: #f0e0d0; }
  body.dark .work-card { background: rgba(80,60,48,.6); }
  body.dark .work-card:hover { background: rgba(90,70,55,.75); }
  body.dark .work-info h3 { color: #f0e0d0; }
  body.dark .work-info p { color: #d4bfa8; }
  body.dark .work-icon { background: rgba(200,160,120,.12); }
  body.dark .empty-hint { color: #8b6f5a; }

  @media (max-width: 600px) {
    .page { padding: 32px 16px 0; }
    .page-title { font-size: 22px; margin: 0 0 20px; }
    .works-grid { grid-template-columns: 1fr; }
    .work-card { padding: 16px; gap: 14px; }
    .work-icon { width: 40px; height: 40px; border-radius: 8px; }
    .work-icon :global(svg) { width: 20px; height: 20px; }
    .work-info h3 { font-size: 15px; }
  }
</style>
